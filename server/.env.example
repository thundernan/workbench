# Server Configuration
PORT=3001

# MongoDB Configuration
# Option 1: Use MongoDB Atlas (Cloud) - Recommended for production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/workbench?retryWrites=true&w=majority

# Option 2: Use local MongoDB (Uncomment and set MONGODB_URI to empty to use these)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_DB_NAME=workbench
# MONGODB_USERNAME=
# MONGODB_PASSWORD=

# Blockchain Configuration (Set in blockchain.ts)
# RPC_URL is configured in server/src/config/blockchain.ts
# Contract addresses are managed in server/src/config/blockchain.ts

# CORS Configuration (Optional - defaults to allow all)
# CORS_ORIGIN=http://localhost:3000
