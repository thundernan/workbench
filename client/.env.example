# API Configuration
# Leave empty for development (uses Vite proxy)
# Set to your deployed backend URL for production
VITE_API_BASE_URL=

# Blockchain Configuration - Status Network Sepolia
# WorkbenchInstance Contract Address
VITE_WORKBENCH_INSTANCE_CONTRACT_ADDRESS=0xa64390F04c18194Be5BeB0bd362e6642EB05Ab62

# GameItemsERC1155 (Token) Contract Address
VITE_TOKEN_CONTRACT_ADDRESS=0x931224dB3Be4592Bf985Aaa4B9B20a99e3aC2CC4

# Marketplace Contract Address
VITE_MARKETPLACE_CONTRACT_ADDRESS=0xFaa229eD5AD24Dfdfd2348ED716DE49ce042fa25

# Status Network Sepolia RPC URL
VITE_PUBLIC_RPC_URL=https://public.sepolia.rpc.status.network

# WalletConnect Project ID (Optional - for WalletConnect support)
# Get your project ID from: https://cloud.walletconnect.com
# VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here
